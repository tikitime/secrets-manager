---
# secrets-manager per-user config. Copy to `secrets-manager.local.md` at your
# project root (it's gitignored — NEVER commit it). /secrets-onboard writes this
# for you; this example just shows the shape.

op_account: myteam.1password.com        # your 1Password account
op_vault: "Developer Vault - Name"      # YOUR vault — quote it (may contain spaces)
notion_tasks_db: 0000000000000000000000000000000   # Notion DB id for rotation tasks
notion_assignee: 00000000-0000-0000-0000-000000000000   # your Notion user id

# Optional:
# notion_token_item: NOTION_TOKEN       # 1P item with a Notion integration token,
#                                        # used only by the headless notify-notion.py path
enable_discord: false                   # leave false unless you want chat alerts too
# discord_webhook_item: DISCORD_ROTATION_WEBHOOK
---
# This file holds NO secret values — only references and ids. Real secrets live
# in 1Password and are read at runtime via op:// references.
